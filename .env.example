# LLM Provider Configuration
LLM_PROVIDER=openai # gemini | openai | anthropic | ollama | mock
LLM_API_KEY=your_openai_or_gemini_api_key_here
LLM_MODEL=gpt-4o-mini

# Model Embeddings & Reranker
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RERANK_MODEL=cross-encoder/ms-marco-TinyBERT-L-2-v2
OCR_LANGS=eng+hin


# Pipeline Thresholds
MAX_FILE_MB=25
ABSTAIN_THRESHOLD=0.25
TOP_K_RETRIEVE=20
TOP_K_FINAL=8

# Storage Paths
DATABASE_URL=sqlite:///./data/app.db
CHROMA_PERSIST_DIR=./data/chroma
UPLOAD_DIR=./data/uploads

# Offline Flags (Set to 1 to run completely offline without Hugging Face network calls)
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
